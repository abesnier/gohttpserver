FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app
COPY go.mod .
#COPY go.sum .
#RUN go mod tidy && go mod download
# Binary Compression
RUN apk upgrade --no-cache && apk add upx --no-cache

# Build app and pack using upx
ADD . /app
RUN go mod tidy && go mod download &&  CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags '-s -w -X main.VERSION=docker' -o gohttpserver && upx gohttpserver

FROM alpine:3
WORKDIR /app
ADD assets /usr/local/bin/assets
COPY --from=build /app/gohttpserver /usr/local/bin/gohttpserver
EXPOSE 8000
ENTRYPOINT [ "/usr/local/bin/gohttpserver" , "--root=/app/public"]
